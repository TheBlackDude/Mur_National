rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    // token.get(): a missing claim reads as false instead of raising an evaluation error on every citizen request.
    function hasRole(role) { return signedIn() && request.auth.token.get(role, false) == true; }
    function isStaff() { return hasRole('moderator') || hasRole('editor') || hasRole('maeiage') || hasRole('admin'); }

    // A device may only write under its own uid: the framed JPEG under 2 MB, or a video selfie clip under 80 MB.
    match /uploads/{uid}/{file} {
      allow write: if signedIn() && request.auth.uid == uid
                   && ((request.resource.contentType == 'image/jpeg' && request.resource.size < 2 * 1024 * 1024)
                       || (request.resource.contentType.matches('video/.*') && request.resource.size < 80 * 1024 * 1024));
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
    }
    // Diaspora videos: mission token is validated by the submitVideo callable after upload.
    match /videos/{mission}/{file} {
      allow write: if signedIn()
                   && request.resource.contentType.matches('video/.*')
                   && request.resource.size < 150 * 1024 * 1024;
      allow read: if isStaff();
    }
    // Renditions waiting for moderation: staff preview them from /admin; approval copies them to public/ and thumbs/.
    match /staging/{kind}/{file} { allow read: if isStaff(); allow write: if false; }
    match /public/{file} { allow read: if true; allow write: if false; }
    match /thumbs/{file} { allow read: if true; allow write: if false; }
    match /snapshot/{file} { allow read: if true; allow write: if false; }
    match /exports/{file} { allow read: if isStaff(); allow write: if false; }
  }
}
